{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 25,
    "modules-left": ["custom/mango-tags", "custom/mango-layout", "custom/mango-keymode"],
    "modules-center": ["custom/mango-window", "custom/cava"],
    "modules-right": ["custom/wallpaper", "custom/gpu", "custom/disk", "custom/weather", "custom/power", "custom/notifications", "mpris", "cpu", "memory", "wireplumber", "wireplumber#microphone", "battery", "network", "clock", "tray"],

    "custom/mango-tags": {
        "exec": "~/.local/bin/waybar-mango tags",
        "return-type": "json",
        "interval": 1,
        "on-click": "mmsg dispatch toggleoverview",
        "format": "{}"
    },

    "custom/mango-layout": {
        "exec": "~/.local/bin/waybar-mango layout",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    "custom/mango-keymode": {
        "exec": "~/.local/bin/waybar-mango keymode",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    "custom/mango-window": {
        "exec": "~/.local/bin/waybar-mango window",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    "custom/cava": {
        "exec": "~/.local/bin/waybar-cava",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    "custom/wallpaper": {
        "exec": "~/.local/bin/wallpaperctl status",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.local/bin/wallpaperctl pick",
        "on-click-right": "~/.local/bin/wallpaperctl next",
        "format": "{}"
    },

    "custom/gpu": {
        "exec": "~/.local/bin/waybar-gpu",
        "return-type": "json",
        "interval": 2,
        "format": "{}"
    },

    "custom/disk": {
        "exec": "~/.local/bin/waybar-disk",
        "return-type": "json",
        "interval": 30,
        "format": "{}"
    },

    "custom/weather": {
        "exec": "~/.local/bin/waybar-weather",
        "return-type": "json",
        "interval": 1800,
        "format": "{}"
    },

    "custom/power": {
        "exec": "~/.local/bin/waybar-power",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/waybar-power cycle",
        "format": "{}"
    },

    "custom/notifications": {
        "exec": "~/.local/bin/waybar-notifications",
        "return-type": "json",
        "interval": 10,
        "on-click": "swaync-client -t",
        "format": "{}"
    },

    "mpris": {
        "title-len": 32,
        "interval": 1,
        "album-len": 0,
        "max-len": 44,
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{player_icon} {artist} - {title}",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵",
            "spotify": " ",
            "firefox": ""
        },
        "status-icons": {
            "paused": ""
        },
        "ignored-players": ["vlc", "firefox", "brave"]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "cpu": {
        "interval": 2,
        "format": "   {}%"
    },

    "memory": {
        "interval": 2,
        "format": "   {}%"
    },

    "clock": {
        "format": "󰃰  {:%a, %b %e %H:%M }",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", "", "", ""]
    },

    "wireplumber": {
        "format": " {volume}%",
        "format-muted": " Muted",
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5
    },

    "wireplumber#microphone": {
        "node-type": "Audio/Source",
        "format": "󰍮 {volume}%",
        "format-muted": "󰍮 Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "{ipaddr}/{cidr}  ",
        "tooltip-format": "{essid} - {ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}:{essid} {ipaddr}/{cidr}"
    }
}

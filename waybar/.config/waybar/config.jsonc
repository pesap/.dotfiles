{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 25,
    "modules-left": ["custom/mango-tags", "custom/mango-layout"],
    "modules-center": ["custom/mango-window"],
    "modules-right": ["custom/wallpaper", "custom/system", "custom/power", "wireplumber", "network", "clock", "tray"],

    "custom/mango-tags": {
        "exec": "~/.local/bin/waybar-mango tags",
        "return-type": "json",
        "interval": 1,
        "on-click": "mmsg dispatch toggleoverview",
        "format": "{}"
    },

    "custom/mango-layout": {
        "exec": "~/.local/bin/waybar-mango layout",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    "custom/mango-window": {
        "exec": "~/.local/bin/waybar-mango window",
        "return-type": "json",
        "interval": 1,
        "max-length": 32,
        "format": "{}"
    },

    "custom/wallpaper": {
        "exec": "~/.local/bin/wallpaperctl status",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.local/bin/wallpaperctl pick",
        "on-click-right": "~/.local/bin/wallpaperctl next",
        "format": "{}"
    },

    "custom/system": {
        "exec": "~/.local/bin/waybar-system",
        "return-type": "json",
        "interval": 10,
        "format": "{}"
    },

    "custom/power": {
        "exec": "~/.local/bin/waybar-power",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/waybar-power cycle",
        "format": "{}"
    },

    "wireplumber": {
        "format": " {volume}%",
        "format-muted": "",
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "tooltip-format": "{essid} - {ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "⚠",
        "format-alt": "{ifname}: {essid} {ipaddr}"
    },

    "clock": {
        "format": "󰃰 {:%a %b %e  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}

    "custom/pomodoro": {
      "format": "<span foreground='#df97f7'>{} {icon}</span>",
      "return-type": "json",
      "format-icons": {
        "work": "💼",
        "break": "",
      },
      "exec": "$HOME/waybar-module-pomodoro/target/release/waybar-module-pomodoro",
      "on-click": "$HOME/waybar-module-pomodoro/target/release/waybar-module-pomodoro toggle",
      "on-click-right": "$HOME/waybar-module-pomodoro/target/release/waybar-module-pomodoro reset",
  },
{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 32,
    "modules-left": ["custom/mango-tags", "custom/mango-layout", "custom/wallpaper"],
    "modules-center": ["custom/mango-window"],
    "modules-right": ["group/system-usage", "custom/temperatures", "custom/power", "custom/volume", "network", "bluetooth", "clock", "tray"],

    "custom/mango-tags": {
        "exec": "~/.local/bin/waybar-mango watch tags",
        "return-type": "json",
        "restart-interval": 2,
        "on-click": "mmsg dispatch toggleoverview",
        "format": "{}"
    },

    "custom/mango-layout": {
        "exec": "~/.local/bin/waybar-mango watch layout",
        "return-type": "json",
        "restart-interval": 2,
        "format": "{}"
    },

    "custom/mango-window": {
        "exec": "~/.local/bin/waybar-mango watch window",
        "return-type": "json",
        "restart-interval": 2,
        "max-length": 32,
        "format": "{}"
    },

    "custom/wallpaper": {
        "exec": "~/.local/bin/wallpaperctl status",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.local/bin/wallpaperctl pick",
        "on-click-right": "~/.local/bin/wallpaperctl next",
        "format": "WALL"
    },

    "custom/memory": {
        "exec": "~/.local/bin/waybar-memory",
        "return-type": "json",
        "interval": 5,
        "format": "{}"
    },

    "custom/disk": {
        "exec": "~/.local/bin/waybar-disk",
        "return-type": "json",
        "interval": 30,
        "format": "{}"
    },

    "custom/gpu": {
        "exec": "~/.local/bin/waybar-gpu",
        "return-type": "json",
        "interval": 5,
        "format": "{}"
    },

    "custom/power": {
        "exec": "~/.local/bin/waybar-power",
        "return-type": "json",
        "interval": 30,
        "on-click": "~/.local/bin/waybar-power cycle",
        "format": "{}"
    },

    "custom/volume": {
        "exec": "~/.local/bin/waybar-volume",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.local/bin/waybar-volume toggle",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "format": "{}"
    },

    "custom/temperatures": {
        "exec": "~/.local/bin/waybar-temperature",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/waybar-temperature notify",
        "format": "{}"
    },

    "group/system-usage": {
        "orientation": "horizontal",
        "modules": ["custom/memory", "custom/disk", "custom/gpu"]
    },

    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-disabled": "",
        "format-off": "",
        "format-no-controller": "",
        "max-length": 1,
        "tooltip-format": "{num_connections} connected",
        "tooltip-format-connected": "{num_connections} connected",
        "tooltip-format-enumerate-connected": "connected",
        "tooltip-format-enumerate-disconnected": "disconnected"
    },

    "network": {
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "NET wired",
        "tooltip-format": "network status",
        "format-linked": "NET no link",
        "format-disconnected": "NET down",
        "format-alt": "NET"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<b>{:%A, %B %d, %Y}</b>\n\n<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}

#!/usr/bin/env bun
// gg - Git workflow helper

import { $, TOML } from "bun";
import { parseArgs } from "util";

// Disable shell command echoing by default
$.throws(true);

// Colors
const red = (s: string) => `\x1b[31m${s}\x1b[0m`;
const green = (s: string) => `\x1b[32m${s}\x1b[0m`;
const cyan = (s: string) => `\x1b[36m${s}\x1b[0m`;

const info = (msg: string) => console.log(`${green(">")} ${msg}`);
const error = (msg: string) => {
  console.error(`${red("error:")} ${msg}`);
  process.exit(1);
};

const yellow = (s: string) => `\x1b[33m${s}\x1b[0m`;
const dim = (s: string) => `\x1b[2m${s}\x1b[0m`;
const warn = (msg: string) => console.log(`${yellow("warn:")} ${msg}`);

// --- repos types & helpers ---

interface RepoEntry {
  git: string;
  path?: string;
  branch?: string;
  tag?: string;
  rev?: string;
}

interface ReposConfig {
  path: string;
  repos: Record<string, RepoEntry>;
}

type RefSpec = { type: "branch" | "tag" | "rev"; value: string };

async function loadReposConfig(configPath: string): Promise<ReposConfig> {
  const file = Bun.file(configPath);
  if (!(await file.exists())) error(`Config not found: ${configPath}`);
  const raw = TOML.parse(await file.text()) as any;

  if (!raw.path || typeof raw.path !== "string") error(`Missing 'path' in ${configPath}`);
  if (!raw.repos || typeof raw.repos !== "object") error(`Missing 'repos' in ${configPath}`);

  for (const [name, entry] of Object.entries(raw.repos) as [string, any][]) {
    if (!entry.git) error(`Repo '${name}' missing 'git' URL`);
    const refs = [entry.branch, entry.tag, entry.rev].filter(Boolean);
    if (refs.length !== 1) error(`Repo '${name}' must have exactly one of branch, tag, or rev`);
  }

  return raw as ReposConfig;
}

function repoDir(basePath: string, name: string, entry: RepoEntry): string {
  return entry.path ?? `${basePath}/${name}`;
}

function getRef(entry: RepoEntry): RefSpec {
  if (entry.branch) return { type: "branch", value: entry.branch };
  if (entry.tag) return { type: "tag", value: entry.tag };
  return { type: "rev", value: entry.rev! };
}

async function repoExists(dir: string): Promise<boolean> {
  return await Bun.file(`${dir}/.git`).exists() ||
    await Bun.file(`${dir}/.git/HEAD`).exists();
}

async function shortSha(dir: string, fallback = "???????"): Promise<string> {
  return (await $`git -C ${dir} rev-parse --short HEAD`.text().catch(() => fallback)).trim();
}

// --- progress bar ---

const BAR_WIDTH = 20;
const FILLED = "█";
const EMPTY = "░";

function drawProgress(done: number, total: number, label: string): void {
  const ratio = total > 0 ? done / total : 0;
  const filled = Math.round(ratio * BAR_WIDTH);
  const bar = FILLED.repeat(filled) + EMPTY.repeat(BAR_WIDTH - filled);
  process.stdout.write(`\r\x1b[K  ${dim(bar)}  ${dim(`${done}/${total}`)}  ${dim(label)}`);
}

function clearProgress(): void {
  process.stdout.write(`\r\x1b[K`);
}

// Run repo tasks in parallel with progress, then print results in order
async function runWithProgress<T extends { line: string }>(
  label: string,
  entries: [string, RepoEntry][],
  task: (name: string, entry: RepoEntry, index: number, tick: () => void) => Promise<T>,
): Promise<void> {
  const total = entries.length;
  let done = 0;
  drawProgress(0, total, label);

  const results = await Promise.all(
    entries.map(([name, entry], i) =>
      task(name, entry, i, () => { done++; drawProgress(done, total, name); })
    ),
  );

  clearProgress();
  console.log();
  for (const row of results) console.log(row.line);
  console.log();
}

// --- repos commands ---

async function syncRepoEntry(
  basePath: string,
  name: string,
  entry: RepoEntry,
  maxName: number,
  skipSet: Set<string>,
  tick: () => void,
): Promise<{ line: string }> {
  const dir = repoDir(basePath, name, entry);
  const ref = getRef(entry);
  const padName = name.padEnd(maxName);

  if (skipSet.has(name)) {
    tick();
    return { line: `  ${dim("SKIP ")}  ${padName}  ${dim("skipped")}` };
  }

  const exists = await repoExists(dir);

  if (!exists) {
    await $`git clone ${entry.git} ${dir}`.quiet();
  } else {
    const currentUrl = (await $`git -C ${dir} remote get-url origin`.text()).trim();
    if (currentUrl !== entry.git) {
      await $`git -C ${dir} remote set-url origin ${entry.git}`;
    }
  }

  await $`git -C ${dir} fetch origin`.quiet();

  const oldSha = exists ? await shortSha(dir, "") : "";

  if (ref.type === "branch") {
    const localBranchExists =
      (await $`git -C ${dir} branch --list ${ref.value}`.text()).trim() !== "";
    const remoteBranchExists = await $`git -C ${dir} rev-parse --verify origin/${ref.value}`
      .quiet().then(() => true).catch(() => false);

    if (localBranchExists) {
      await $`git -C ${dir} checkout ${ref.value}`.quiet();
      if (remoteBranchExists) {
        await $`git -C ${dir} reset --hard origin/${ref.value}`.quiet();
      }
    } else if (remoteBranchExists) {
      await $`git -C ${dir} checkout -b ${ref.value} origin/${ref.value}`.quiet();
    } else {
      // Neither local nor remote branch exists — create it from HEAD and push
      await $`git -C ${dir} checkout -b ${ref.value}`.quiet();
      await $`git -C ${dir} push -u origin ${ref.value}`.quiet();
    }
  } else if (ref.type === "tag") {
    await $`git -C ${dir} checkout --detach refs/tags/${ref.value}`.quiet();
  } else {
    await $`git -C ${dir} checkout --detach ${ref.value}`.quiet();
  }

  const newSha = await shortSha(dir);
  tick();

  let label: string;
  if (!oldSha) {
    label = `${dim(newSha)}  ${dim("cloned")}`;
  } else if (oldSha === newSha) {
    label = `${dim(newSha)}  ${dim("up to date")}`;
  } else {
    label = `${dim(oldSha)} → ${dim(newSha)}`;
  }
  return { line: `  ${green("OK   ")}  ${padName}  ${cyan(ref.value)}  ${label}` };
}

async function cmdReposSync(configPath: string) {
  const config = await loadReposConfig(configPath);
  const basePath = config.path;
  const entries = Object.entries(config.repos);
  const maxName = Math.max(...entries.map(([n]) => n.length));

  // Phase 1: check dirty repos sequentially (needs interactive prompt)
  const skipSet = new Set<string>();
  for (const [name, entry] of entries) {
    const dir = repoDir(basePath, name, entry);
    if (await repoExists(dir)) {
      const dirty = (await $`git -C ${dir} status --porcelain`.text()).trim() !== "";
      if (dirty) {
        console.log(`  ${yellow("DIRTY")}  ${name}  ${yellow("uncommitted changes")}`);
        if (!(await yesOrNo(`    Discard changes in ${name}?`))) {
          skipSet.add(name);
        }
      }
    }
  }

  // Phase 2: sync all repos in parallel
  await runWithProgress("syncing...", entries, async (name, entry, _i, tick) => {
    return syncRepoEntry(basePath, name, entry, maxName, skipSet, tick);
  });
}

async function cmdRepoSync(configPath: string, name: string) {
  if (!name) error("Usage: gg repo sync <name> [--config path]");
  const config = await loadReposConfig(configPath);
  const entry = config.repos[name];
  if (!entry) {
    const known = Object.keys(config.repos);
    const suffix = known.length > 0 ? ` Known: ${known.sort().join(", ")}` : "";
    error(`Unknown repo '${name}'.${suffix}`);
  }

  const basePath = config.path;
  const entries: [string, RepoEntry][] = [[name, entry]];
  const maxName = name.length;

  // Check dirty repo
  const skipSet = new Set<string>();
  const dir = repoDir(basePath, name, entry);
  if (await repoExists(dir)) {
    const dirty = (await $`git -C ${dir} status --porcelain`.text()).trim() !== "";
    if (dirty) {
      console.log(`  ${yellow("DIRTY")}  ${name}  ${yellow("uncommitted changes")}`);
      if (!(await yesOrNo(`    Discard changes in ${name}?`))) {
        skipSet.add(name);
      }
    }
  }

  await runWithProgress("syncing...", entries, async (repoName, repoEntry, _i, tick) => {
    return syncRepoEntry(basePath, repoName, repoEntry, maxName, skipSet, tick);
  });
}

async function cmdReposStatus(configPath: string) {
  const config = await loadReposConfig(configPath);
  const basePath = config.path;
  const entries = Object.entries(config.repos);
  const maxName = Math.max(...entries.map(([n]) => n.length));
  const total = entries.length;

  let done = 0;
  drawProgress(0, total, "checking...");

  type RepoInfo = {
    name: string;
    icon: string;
    ref: string;
    sha: string;
    tags: string[];
  };

  const rows = await Promise.all(entries.map(async ([name, entry]): Promise<RepoInfo> => {
    const dir = repoDir(basePath, name, entry);
    const ref = getRef(entry);

    if (!(await repoExists(dir))) {
      done++; drawProgress(done, total, name);
      return { name, icon: red("MISS "), ref: ref.value, sha: "", tags: [red("not cloned")] };
    }

    const head = (await $`git -C ${dir} rev-parse --abbrev-ref HEAD`.text().catch(() => "unknown")).trim();
    const sha = await shortSha(dir);
    const dirty = (await $`git -C ${dir} status --porcelain`.text()).trim() !== "";
    const tags: string[] = [];

    let ok: boolean;
    if (ref.type === "branch") {
      ok = head === ref.value;
      if (!ok) tags.push(red(`on ${head}`));
    } else {
      const headSha = (await $`git -C ${dir} rev-parse HEAD`.text()).trim();
      let expectedSha: string;
      if (ref.type === "tag") {
        expectedSha = (await $`git -C ${dir} rev-parse refs/tags/${ref.value}^{}`.text().catch(
          () => $`git -C ${dir} rev-parse refs/tags/${ref.value}`.text()
        )).trim();
      } else {
        expectedSha = ref.value;
      }
      ok = headSha.startsWith(expectedSha.slice(0, 7)) || expectedSha.startsWith(headSha.slice(0, 7));
      if (!ok) tags.push(red(`at ${headSha.slice(0, 8)}`));
    }

    if (dirty) tags.push(yellow("dirty"));

    let icon: string;
    if (!ok) icon = red("FAIL ");
    else if (dirty) icon = yellow("DIRTY");
    else icon = green("OK   ");

    done++; drawProgress(done, total, name);
    return { name, icon, ref: ref.value, sha, tags };
  }));

  clearProgress();
  const maxRef = Math.max(...rows.map((r) => r.ref.length));

  console.log();
  for (const row of rows) {
    const padName = row.name.padEnd(maxName);
    const padRef = row.ref.padEnd(maxRef);
    const sha = row.sha ? dim(row.sha) : dim("───────");
    const tagStr = row.tags.length > 0 ? "  " + row.tags.join(dim(" · ")) : "";
    console.log(`  ${row.icon}  ${padName}  ${cyan(padRef)}  ${sha}${tagStr}`);
  }
  console.log();
}

async function cmdReposPull(configPath: string) {
  const config = await loadReposConfig(configPath);
  const basePath = config.path;
  const entries = Object.entries(config.repos);
  const maxName = Math.max(...entries.map(([n]) => n.length));

  await runWithProgress("pulling...", entries, async (name, entry, _i, tick) => {
    const dir = repoDir(basePath, name, entry);
    const ref = getRef(entry);
    const padName = name.padEnd(maxName);

    if (!(await repoExists(dir))) {
      tick();
      return { line: `  ${red("MISS ")}  ${padName}  ${dim("not cloned")}` };
    }

    if (ref.type !== "branch") {
      tick();
      return { line: `  ${dim("SKIP ")}  ${padName}  ${dim(`pinned to ${ref.type}=${ref.value}`)}` };
    }

    const oldSha = await shortSha(dir);
    await $`git -C ${dir} fetch origin`.quiet();
    await $`git -C ${dir} reset --hard origin/${ref.value}`.quiet();
    const newSha = await shortSha(dir);
    tick();

    const status = oldSha === newSha
      ? `${dim(newSha)}  ${dim("up to date")}`
      : `${dim(oldSha)} → ${dim(newSha)}`;
    return { line: `  ${green("OK   ")}  ${padName}  ${cyan(ref.value)}  ${status}` };
  });
}

// Prompt yes/no (default yes)
async function yesOrNo(msg: string): Promise<boolean> {
  process.stdout.write(`${cyan(msg)} [Y/n] `);
  for await (const line of console) {
    const resp = line.trim().toLowerCase();
    return resp === "" || resp === "y" || resp === "yes";
  }
  return false;
}

// Detect main branch
async function getMainBranch(): Promise<string> {
  const branches = await $`git branch`.text().catch(() => "main");
  return branches.includes(" master") ? "master" : "main";
}

// Detect primary remote
async function getRemote(): Promise<string> {
  const remotes = await $`git remote`.text().catch(() => "origin");
  return remotes.includes("upstream") ? "upstream" : "origin";
}

// gg main - Switch to detached HEAD at remote/main
async function cmdMain() {
  const remote = await getRemote();
  const main = await getMainBranch();
  await $`git fetch ${remote}`.quiet();
  await $`git switch -d ${remote}/${main}`;
}

// gg clone <user/repo>
async function cmdClone(userRepo: string) {
  if (!userRepo?.includes("/")) {
    error("Invalid format. Use: gg clone user/repo");
  }

  const [user, repo] = userRepo.split("/");
  const ghUser = await $`git config --get github.user`.text().catch(() => "");

  if (!ghUser) {
    info(`Cloning ${user}/${repo}...`);
    await $`git clone git@github.com:${user}/${repo}.git`;
    return;
  }

  info(`Cloning your fork of ${user}/${repo}...`);
  await $`git clone git@github.com:${ghUser.trim()}/${repo}.git`;

  if (user !== ghUser.trim()) {
    $.cwd(repo);
    info("Adding upstream remote...");
    await $`git remote add upstream git@github.com:${user}/${repo}.git`;
    await $`git fetch upstream`.quiet();

    const branch = (await $`git rev-parse --abbrev-ref HEAD`.text()).trim();
    await $`git switch ${branch}`;
    await $`git reset --hard upstream/${branch}`;
    await $`git branch --set-upstream-to=upstream/${branch}`;
  }

  info(`Done! cd ${repo}`);
}

// gg worktree add <name>
async function cmdWorktreeAdd(name: string) {
  if (!name) error("Usage: gg worktree add <name>");

  const main = await getMainBranch();
  await $`git worktree add ./${name} ${main} --detach`;
  info(`Created worktree at ./${name}`);
}

// gg worktree init <remote>
async function cmdWorktreeInit(remote: string) {
  if (!remote) error("Usage: gg worktree init <remote-url>");

  const dirName = remote.split("/").pop()?.replace(".git", "") ?? "repo";

  await $`mkdir -p ${dirName}`;
  $.cwd(dirName);
  await $`git clone --bare ${remote} .bare`;
  await Bun.write(".git", "gitdir: ./.bare");
  await $`git config remote.origin.fetch +refs/heads/*:refs/remotes/origin/*`;

  info(`Bare repo initialized at ${dirName}`);
  info("Use 'gg worktree add <name>' to add worktrees");
}

// gg amend - Stage, show diff, confirm, amend
async function cmdAmend() {
  await $`git add .`;
  console.log();
  await $`git --no-pager diff --cached --color=always`;
  console.log();
  await $`git --no-pager show -s --oneline --abbrev-commit --color=always HEAD`;
  console.log();

  if (await yesOrNo("Continue?")) {
    await $`git commit --amend --no-edit`;
    info("Amended last commit");
  } else {
    info("Aborted");
  }
}

// gg fixup [commit]
async function cmdFixup(target?: string) {
  if (!target) {
    // Use fzf to select commit
    const log = await $`git log --oneline -50`.text();
    const selected = await $`fzf --height 50% --layout=reverse --border=rounded --prompt=${"Fixup commit> "} --header=${"Select commit to fixup"}`
      .stdin(log)
      .text()
      .catch(() => "");

    if (!selected) return;
    target = selected.split(" ")[0];
  }

  await $`git commit --fixup=${target}`;
  info(`Created fixup commit for ${target}`);
  info(`Run 'git rebase -i --autosquash ${target}^' to apply`);
}

// gg switch [branch] [--remote]
async function cmdSwitch(branch?: string, useRemote = false) {
  const remote = await getRemote();
  const main = await getMainBranch();

  // Special case: "tip"
  if (branch === "tip") {
    await $`git fetch ${remote} ${main}`.quiet();
    await $`git switch -d ${remote}/${main}`;
    return;
  }

  if (branch) {
    await $`git switch ${branch}`;
    return;
  }

  // No branch - use fzf
  let branches: string;
  if (useRemote) {
    await $`git fetch`.quiet();
    branches = await $`git branch -r`.text();
  } else {
    branches = await $`git branch`.text();
  }

  const selected = await $`fzf --info=inline --height=~100% --reverse --tac`
    .stdin(branches)
    .text()
    .catch(() => "");

  if (!selected) return;

  const branchName = selected.trim().replace(`${remote}/`, "");
  await $`git switch ${branchName}`;
}

// gg branch <name> [--offline]
async function cmdBranch(name: string, offline = false) {
  if (!name) error("Usage: gg branch <name> [--offline]");

  const remote = await getRemote();
  const main = await getMainBranch();

  if (offline) {
    await $`git switch --create ${name}`;
    await $`git reset --hard ${main}`;
  } else {
    await $`git fetch ${remote} ${main}`.quiet();
    await $`git switch --create ${name}`;
    await $`git reset --hard ${remote}/${main}`;
  }

  info(`Created branch ${name}`);
}

// gg prune
async function cmdPrune() {
  const merged = await $`git branch --merged`.text();
  const branches = merged
    .split("\n")
    .map((b) => b.trim())
    .filter((b) => b && !b.startsWith("*") && !b.startsWith("+") && b !== "main" && b !== "master");

  if (branches.length === 0) {
    info("No merged branches to prune");
    return;
  }

  console.log(`Will delete: ${branches.join(", ")}`);
  for (const branch of branches) {
    await $`git branch -D ${branch}`;
  }
  info("Pruned merged branches");
}

// gg commit [message] [--branch name]
async function cmdCommit(message = ".", branch?: string) {
  await $`git add --all`;
  console.log();
  await $`git --no-pager diff --cached --color=always`;
  console.log();

  if (branch) {
    await $`git switch -c ${branch}`;
    await $`git commit -m ${message}`;
    await $`git switch -`;
  } else {
    await $`git commit -m ${message}`;
  }
}

// gg uncommit
async function cmdUncommit() {
  const message = await $`git log --format=%B -n 1 HEAD`.text();
  await $`git reset --mixed HEAD~`;
  await $`git commit --allow-empty -m ${message.trim()}`;
  info("Uncommitted (message preserved as empty commit)");
}

// gg reset
async function cmdReset() {
  await $`git status --porcelain`;
  console.log();

  if (await yesOrNo("Reset and clean all changes?")) {
    await $`git reset --hard`;
    await $`git clean -fd`;
    info("Reset complete");
  } else {
    info("Aborted");
  }
}

// gg sync [--to branch] - Sync FROM remote
async function cmdSync(branch?: string) {
  const remote = await getRemote();
  const currentBranch = (await $`git rev-parse --abbrev-ref HEAD`.text()).trim();
  branch ??= currentBranch;

  info(`Syncing ${branch} from ${remote}...`);
  await $`git fetch ${remote} ${branch}`.quiet();

  const localBranchExists =
    (await $`git branch --list ${branch}`.text()).trim() !== "";

  if (!localBranchExists) {
    await $`git switch -c ${branch} ${remote}/${branch}`;
  } else {
    if (currentBranch !== branch) {
      await $`git switch ${branch}`;
    }
    await $`git reset --hard ${remote}/${branch}`;
  }

  info(`Synced to ${remote}/${branch}`);
}

// gg refresh [--from commit] [--to branch]
async function cmdRefresh(from?: string, to?: string) {
  const remote = await getRemote();
  const main = await getMainBranch();

  if (!to) {
    await $`git fetch ${remote} ${main}`.quiet();
    to = `${remote}/${main}`;
  }

  if (from) {
    info(`Rebasing onto ${to} (from ${from}^)...`);
    await $`git rebase --onto ${to} ${from}^`;
  } else {
    info(`Rebasing onto ${to}...`);
    await $`git rebase ${to}`;
  }
}

// gg pr <number> [--review]
async function cmdPr(prNumber: string, review = false) {
  if (!prNumber) error("Usage: gg pr <number> [--review]");

  const remote = await getRemote();
  const main = await getMainBranch();

  info(`Fetching PR #${prNumber}...`);
  await $`git fetch ${remote}`.quiet();
  await $`git fetch ${remote} refs/pull/${prNumber}/head`.quiet();
  await $`git switch --detach FETCH_HEAD`;

  if (review) {
    const base = (await $`git merge-base FETCH_HEAD ${remote}/${main}`.text()).trim();
    await $`git reset ${base}`;
    info("Reset to merge base for review");
  }

  info(`Checked out PR #${prNumber}`);
}

// gg push [--to remote]
async function cmdPush(remote = "origin") {
  const branch = (await $`git rev-parse --abbrev-ref HEAD`.text()).trim();
  info(`Pushing ${branch} to ${remote}...`);
  await $`git push -u ${remote} ${branch} --force-with-lease`;
}

// Usage
function usage() {
  console.log(`gg - Git workflow helper

USAGE:
    gg <command> [args] [flags]

COMMANDS:
    main                    Switch to detached HEAD at remote/main
    clone <user/repo>       Clone repo with upstream setup
    worktree add <name>     Create worktree at main (detached)
    worktree init <remote>  Initialize bare repo for worktrees
    amend                   Stage all, show diff, confirm, amend
    fixup [<commit>]        Create fixup commit (fzf picker if no commit)
    switch [<branch>]       Switch branch (fzf if none, --remote for remote)
    branch <name>           Create branch from main (--offline to skip fetch)
    prune                   Delete merged branches
    commit [<msg>]          Add all and commit (--branch <name> for side branch)
    uncommit                Undo commit, keep message as empty commit
    reset                   Hard reset + clean (with confirmation)
    sync                    Sync FROM remote (fetch + reset, --to <branch>)
    refresh                 Rebase onto main (--from <commit>, --to <branch>)
    pr <number>             Checkout PR locally (--review for merge base)
    push                    Push to remote (--to <remote>)
    repo sync <name>         Sync a single repo from repos.toml
    repos sync              Clone/checkout repos from repos.toml
    repos status            Show status of managed repos
    repos pull              Pull latest for branch-tracking repos
    status                  Compact git status
    log                     Compact git log

EXAMPLES:
    gg main                     # Switch to latest remote/main
    gg clone rust-lang/rust     # Clone with upstream
    gg branch my-feature        # Create branch from main
    gg commit "fix: bug"        # Add all + commit
    gg amend                    # Stage + show diff + amend
    gg sync                     # Sync current branch from remote
    gg refresh --from abc123    # Stacked PR rebase
    gg pr 123 --review          # Review PR changes
    gg repo sync my-repo        # Sync single repo from repos.toml
    gg repos sync               # Clone/sync repos from repos.toml
    gg repos status             # Check status of managed repos
    gg repos pull               # Pull branch-tracking repos
    gg repos sync -c custom.toml  # Use custom config file`);
}

// Main
async function main() {
  const { values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      remote: { type: "boolean", short: "r", default: false },
      offline: { type: "boolean", short: "o", default: false },
      review: { type: "boolean", default: false },
      branch: { type: "string", short: "b" },
      from: { type: "string" },
      to: { type: "string" },
      config: { type: "string", short: "c" },
      help: { type: "boolean", short: "h", default: false },
    },
    allowPositionals: true,
  });

  if (values.help) {
    usage();
    return;
  }

  const [cmd, arg1, arg2] = positionals;

  switch (cmd) {
    case "main":
      await cmdMain();
      break;
    case "clone":
      await cmdClone(arg1);
      break;
    case "worktree":
      if (arg1 === "add") await cmdWorktreeAdd(arg2);
      else if (arg1 === "init") await cmdWorktreeInit(arg2);
      else error("Usage: gg worktree [add|init] <name>");
      break;
    case "amend":
      await cmdAmend();
      break;
    case "fixup":
      await cmdFixup(arg1);
      break;
    case "switch":
      await cmdSwitch(arg1, values.remote);
      break;
    case "branch":
      await cmdBranch(arg1, values.offline);
      break;
    case "prune":
      await cmdPrune();
      break;
    case "commit":
      await cmdCommit(arg1, values.branch);
      break;
    case "uncommit":
      await cmdUncommit();
      break;
    case "reset":
      await cmdReset();
      break;
    case "sync":
      await cmdSync(values.to);
      break;
    case "refresh":
      await cmdRefresh(values.from, values.to);
      break;
    case "pr":
      await cmdPr(arg1, values.review);
      break;
    case "push":
      await cmdPush(values.to ?? "origin");
      break;
    case "repos": {
      const reposConfig = values.config ?? "repos.toml";
      if (arg1 === "sync") await cmdReposSync(reposConfig);
      else if (arg1 === "status") await cmdReposStatus(reposConfig);
      else if (arg1 === "pull") await cmdReposPull(reposConfig);
      else error("Usage: gg repos [sync|status|pull] [--config path]");
      break;
    }
    case "repo": {
      const reposConfig = values.config ?? "repos.toml";
      if (arg1 === "sync") await cmdRepoSync(reposConfig, arg2);
      else error("Usage: gg repo sync <name> [--config path]");
      break;
    }
    case "status":
    case "st":
      await $`git status --short --branch`;
      break;
    case "log":
    case "lg":
      await $`git log --oneline --graph -20`;
      break;
    case undefined:
    case "":
      usage();
      break;
    default:
      error(`Unknown command: ${cmd} (use --help)`);
  }
}

main().catch((e) => {
  if (e.exitCode !== undefined) process.exit(e.exitCode);
  console.error(e);
  process.exit(1);
});

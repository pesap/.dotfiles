#!/usr/bin/env bash
set -euo pipefail

selected="${1:-$(project-picker)}"
[[ -n "$selected" ]] || exit 0

name=$(project-name "$selected")

session_exists() {
    zellij list-sessions --no-formatting 2>/dev/null |
        awk -v name="$name" '$1 == name && !index($0, "(EXITED") { found=1 } END { exit !found }'
}

if [[ -n "${ZELLIJ:-}" ]]; then
    if ! session_exists; then
        zellij delete-session --force -- "$name" 2>/dev/null || true
        (cd -- "$selected" && zellij attach "$name" --create-background)
    fi
    exec zellij action switch-session "$name"
fi

cd -- "$selected"
exec zellij attach --create -- "$name"

#!/bin/sh
set -eu

profiles='performance balanced power-saver'

case "${1:-status}" in
	cycle)
		current="$(powerprofilesctl get 2>/dev/null || printf balanced)"
		next="balanced"
		case "$current" in
			performance) next=balanced ;;
			balanced) next=power-saver ;;
			power-saver) next=performance ;;
		esac
		powerprofilesctl set "$next"
		;;
esac

profile="$(powerprofilesctl get 2>/dev/null || printf unknown)"
case "$profile" in
	performance) icon='󰓅' ;;
	power-saver) icon='󰌪' ;;
	*) icon='󰾅' ;;
esac
jq -cn --arg text "$icon" --arg tooltip "Power profile: $profile" '{text:$text,tooltip:$tooltip}'

#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE' >&2
Usage: send-to-pane <pane_id> <text> [send_enter] [session_name]

Examples:
  send-to-pane 0 "echo hello"
  send-to-pane 1 "partial text" false
  send-to-pane 2 "npm test" true my-session
USAGE
}

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  usage
  exit 2
fi

pane_id="$1"
text="$2"
send_enter="${3:-true}"
session_name="${4:-${ZELLIJ_SESSION_NAME:-}}"
plugin="file:${HOME}/.config/zellij/plugins/zellij-send-keys.wasm"

if ! [[ "$pane_id" =~ ^[0-9]+$ ]]; then
  echo "send-to-pane: pane_id must be a non-negative integer: $pane_id" >&2
  exit 2
fi

if [ "$send_enter" != "true" ] && [ "$send_enter" != "false" ]; then
  echo "send-to-pane: send_enter must be true or false: $send_enter" >&2
  exit 2
fi

if [ -z "$session_name" ]; then
  session_name="$(zellij list-sessions 2>/dev/null | awk '!/EXITED/ { print $1; exit }')"
fi

if [ -z "$session_name" ]; then
  echo "send-to-pane: no active zellij session found" >&2
  exit 1
fi

payload="$(jq -cn \
  --argjson pane_id "$pane_id" \
  --arg text "$text" \
  --argjson send_enter "$send_enter" \
  '{pane_id: $pane_id, text: $text, send_enter: $send_enter}')"

ZELLIJ_SESSION_NAME="$session_name" zellij action pipe \
  --plugin "$plugin" \
  --name send_keys \
  -- "$payload"

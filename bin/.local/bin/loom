#!/usr/bin/env bash
# Loom: the single public CLI for this workstation configuration.
# See usage() below for the stable command surface; implementations live in
# install.sh and scripts/ so this entry point stays easy to discover.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: loom COMMAND [OPTIONS]

Manage this workstation's configuration from one interface.

Commands:
  setup       Install or update a profile from this checkout or a release
  apply       Apply packages from the existing checkout
  check       Check the machine and/or repository
  desktop     Apply desktop configuration with smoke checks and rollback
  tools       Install or inspect mise-managed tools
  profiles    List supported profiles
  version     Show the checkout version
  help        Show this help

Examples:
  loom setup --local --dry-run --profile common
  loom setup --local --profile common
  loom apply --dry-run --profile common
  loom check
  loom desktop
  loom tools install
EOF
}

fail() {
    printf 'loom: %s\n' "$*" >&2
    exit 2
}

resolve_repo_root() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir=''
    local link_target=''
    local candidate=''

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd "$(dirname "$source_path")" && pwd -P)"
        link_target="$(readlink "$source_path")"
        if [[ "$link_target" == /* ]]; then
            source_path="$link_target"
        else
            source_path="$source_dir/$link_target"
        fi
    done

    candidate="$(cd "$(dirname "$source_path")" && pwd -P)"
    while [[ "$candidate" != "/" ]]; do
        if [[ -f "$candidate/packages.conf" && -f "$candidate/install.sh" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
        candidate="$(dirname "$candidate")"
    done
    fail 'could not locate the dotfiles checkout'
}

repo_root="$(resolve_repo_root)"

case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) PATH="$HOME/.local/bin:$PATH" ;;
esac
if [[ -d "$HOME/.local/share/mise/shims" ]]; then
    case ":$PATH:" in
    *":$HOME/.local/share/mise/shims:"*) ;;
    *) PATH="$HOME/.local/share/mise/shims:$PATH" ;;
    esac
fi
export PATH

run_healthcheck() {
    local profile="${DOTFILES_PROFILE:-common}"
    local status=0
    local tool=''
    local package=''
    local packages=''
    local manifest="$repo_root/packages.conf"

    check_required() {
        local command_name="$1"
        if command -v "$command_name" >/dev/null 2>&1 ||
            [[ "$command_name" == stow && -x "$HOME/.local/bin/stow" ]] ||
            [[ "$command_name" == mise && -x "$HOME/.local/bin/mise" ]] ||
            [[ "$command_name" == loom && -x "$repo_root/bin/.local/bin/loom" ]]; then
            printf 'ok: %s\n' "$command_name"
        else
            printf 'missing: %s\n' "$command_name"
            status=1
        fi
    }

    check_bootstrap_tool() {
        local command_name="$1"
        if command -v "$command_name" >/dev/null 2>&1; then
            printf 'ok: %s\n' "$command_name"
        else
            printf 'missing: %s (install with: loom tools install)\n' "$command_name"
        fi
    }

    check_optional() {
        local command_name="$1"
        if command -v "$command_name" >/dev/null 2>&1; then
            printf 'ok: %s (optional)\n' "$command_name"
        else
            printf 'missing: %s (optional)\n' "$command_name"
        fi
    }

    printf 'Loom machine check (profile: %s)\n' "$profile"
    for tool in stow git curl rsync mise loom; do
        check_required "$tool"
    done
    check_bootstrap_tool pi
    for tool in nvim rg cargo zsh fzf zoxide atuin uv; do
        check_optional "$tool"
    done

    if [[ ! -f "$manifest" ]]; then
        printf 'missing: %s\n' "$manifest"
        return 1
    fi

    packages="$(awk -v profile="$profile" '
        /^[[:space:]]*#/ || NF == 0 { next }
        $1 == profile { $1 = ""; sub(/^[[:space:]]+/, ""); print; found = 1; exit }
        END { if (!found) exit 1 }
    ' "$manifest")" || {
        printf "missing: profile '%s' in %s\n" "$profile" "$manifest"
        return 1
    }

    for package in $packages; do
        if [[ -d "$repo_root/$package" ]]; then
            printf 'ok: package %s\n' "$package"
        elif [[ "$package" == personal ]]; then
            printf 'missing: package %s (optional)\n' "$package"
        else
            printf 'missing: package %s\n' "$package"
            status=1
        fi
    done

    return "$status"
}

check_command() {
    local scope='all'
    local profile=''
    local status=0
    local arg=''

    while (($#)); do
        arg="$1"
        case "$arg" in
        --machine) scope='machine' ;;
        --repo) scope='repo' ;;
        --profile)
            (($# >= 2)) || fail '--profile requires a value'
            profile="$2"
            shift
            ;;
        --profile=*) profile="${arg#--profile=}" ;;
        -h | --help)
            cat <<'EOF'
Usage: loom check [--machine|--repo] [--profile PROFILE]

Run the installed-machine check and repository validation. With no scope,
both checks run. --profile changes the machine package check.
EOF
            return 0
            ;;
        *) fail "unknown check option: $arg" ;;
        esac
        shift
    done

    if [[ "$scope" != repo ]]; then
        if [[ -n "$profile" ]]; then
            if ! DOTFILES_PROFILE="$profile" run_healthcheck; then
                status=1
            fi
        elif ! run_healthcheck; then
            status=1
        fi
    fi

    if [[ "$scope" != machine ]]; then
        printf '\nLoom repository validation\n'
        if ! "$repo_root/scripts/validate.sh"; then
            status=1
        fi
    fi
    return "$status"
}

command_name="${1:-help}"
shift || true

case "$command_name" in
setup)
    exec "$repo_root/install.sh" "$@"
    ;;
apply)
    if [[ -n "${DOTFILES_DIR:-}" ]]; then
        exec "$repo_root/scripts/apply.sh" "$@"
    else
        DOTFILES_DIR="$repo_root" exec "$repo_root/scripts/apply.sh" "$@"
    fi
    ;;
check)
    check_command "$@"
    ;;
desktop)
    if [[ -n "${DOTFILES_ROOT:-}" ]]; then
        exec "$repo_root/scripts/desktop-apply.sh" run "$@"
    else
        DOTFILES_ROOT="$repo_root" exec "$repo_root/scripts/desktop-apply.sh" run "$@"
    fi
    ;;
tools)
    case "${1:-help}" in
    install)
        shift
        exec mise install "$@"
        ;;
    outdated)
        shift
        exec mise outdated "$@"
        ;;
    help | -h | --help)
        cat <<'EOF'
Usage: loom tools COMMAND [OPTIONS]

Commands:
  install     Install versions pinned in the mise manifest
  outdated    Report available updates without installing them
EOF
        ;;
    *)
        fail "unknown tools command: ${1:-}"
        ;;
    esac
    ;;
profiles)
    case "${1:-}" in
    '' | -h | --help)
        printf '%s\n' common linux-desktop macos
        ;;
    *)
        fail "unknown profiles option: $1"
        ;;
    esac
    ;;
version)
    if git -C "$repo_root" describe --always --dirty >/dev/null 2>&1; then
        printf 'loom %s\n' "$(git -C "$repo_root" describe --always --dirty)"
    else
        printf 'loom unknown\n'
    fi
    ;;
help | -h | --help)
    usage
    ;;
*)
    fail "unknown command: $command_name"
    ;;
esac

#!/usr/bin/env bash

if [[ -n "${ZELLIJ_SESSIONIZER_SEARCH_PATHS:-}" ]]; then
  read -r -a SEARCH_PATHS <<< "$ZELLIJ_SESSIONIZER_SEARCH_PATHS"
else
  SEARCH_PATHS=("$HOME/dev" "$HOME/work" "$HOME/sandbox" "$HOME/tmp" "$HOME/Projects" "$HOME/Code")
fi

if [[ -n "${ZELLIJ_SESSIONIZER_SPECIFIC_PATHS:-}" ]]; then
  read -r -a SPECIFIC_PATHS <<< "$ZELLIJ_SESSIONIZER_SPECIFIC_PATHS"
else
  SPECIFIC_PATHS=("$HOME/.dotfiles" "$HOME/.dotfiles/.config/nvim")
fi
OS_TYPE="${ZELLIJ_SESSIONIZER_OS_TYPE:-"$(uname)"}"
ZELLIJ_SWITCH_PLUGIN="${ZELLIJ_SESSIONIZER_SWITCH_PLUGIN:-"https://github.com/mostafaqanbaryan/zellij-switch/releases/download/0.2.1/zellij-switch.wasm"}"

get_atime() {
  local dir="$1"
  if [[ "$OS_TYPE" == "Linux" ]]; then
    stat -c "%X" "$dir" 2>/dev/null || echo "0"
  else
    stat -f "%a" "$dir" 2>/dev/null || echo "0"
  fi
}

session_name_for_dir() {
  basename "$1"
}

generate_display_list() {
  local all_dirs=()

  for search_path in "${SEARCH_PATHS[@]}"; do
    if [[ -d "$search_path" ]]; then
      for dir in "$search_path"/*; do
        if [[ -d "$dir" ]]; then
          all_dirs+=("$dir")
        fi
      done
    fi
  done

  for specific_path in "${SPECIFIC_PATHS[@]}"; do
    if [[ -d "$specific_path" ]]; then
      all_dirs+=("$specific_path")
    fi
  done

  local temp_file
  temp_file=$(mktemp)
  for dir in "${all_dirs[@]}"; do
    local atime
    atime=$(get_atime "$dir")
    echo "$atime $dir" >> "$temp_file"
  done

  local sorted_dirs=()
  while IFS= read -r line; do
    local dir_name="${line#* }"
    sorted_dirs+=("$dir_name")
  done < <(sort -nr "$temp_file")
  rm "$temp_file"

  declare -A session_status
  if command -v zellij >/dev/null 2>&1; then
    while IFS= read -r line; do
      if [[ -n "$line" ]]; then
        local session_name
        session_name=$(echo "$line" | awk '{print $1}')

        if [[ "$line" == *"(current)"* ]]; then
          session_status["$session_name"]=" (current)"
        elif [[ "$line" == *"(EXITED"* ]]; then
          session_status["$session_name"]=" (exited)"
        else
          session_status["$session_name"]=" (active)"
        fi
      fi
    done < <(zellij ls -n 2>/dev/null)
  fi

  for dir in "${sorted_dirs[@]}"; do
    local display_name
    if [[ "$dir" == "$HOME"* ]]; then
      display_name="~${dir#$HOME}"
    else
      display_name="$dir"
    fi
    local session_name
    session_name=$(session_name_for_dir "$dir")

    if [[ -n "${session_status[$session_name]}" ]]; then
      display_name="${display_name}${session_status[$session_name]}"
    fi

    printf '%s\t%s\n' "$dir" "$display_name"
  done
}

if [[ "$1" == "--generate-list" ]]; then
  generate_display_list
  exit 0
fi

temp_script=$(mktemp)
cat > "$temp_script" << 'EOF'
#!/usr/bin/env bash

extract_session_name() {
  basename "$1"
}

if [[ "$1" == "delete" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij delete-session "$session_name" --force 2>/dev/null
  fi
fi

if [[ "$1" == "kill" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij kill-session "$session_name" 2>/dev/null
  fi
fi
EOF

chmod +x "$temp_script"

selected_entry=$(generate_display_list | fzf --delimiter=$'\t' --with-nth=2.. \
  --prompt="Select project: " \
  --header="Enter: Select | Ctrl+D: Delete Session | Ctrl+K: Kill Session" \
  --bind="ctrl-d:execute($temp_script delete {1})+reload($0 --generate-list)" \
  --bind="ctrl-k:execute($temp_script kill {1})+reload($0 --generate-list)")

rm -f "$temp_script"

if [[ -z "$selected_entry" ]]; then
  exit 0
fi
selected_dir="${selected_entry%%$'\t'*}"

session_name=$(session_name_for_dir "$selected_dir")

attach_or_create_session() {
  (
    cd "$selected_dir" || exit 1
    zellij attach "$session_name" --create
  )
}

session_exists() {
  zellij ls -n 2>/dev/null | awk '{print $1}' | grep -Fxq "$session_name"
}

session_has_connected_clients() {
  local client_count
  client_count=$(zellij -s "$session_name" action list-clients 2>/dev/null | awk 'NR > 1 {count++} END {print count + 0}')
  [[ "$client_count" -gt 0 ]]
}

if [[ -v "ZELLIJ" ]]; then
  if ! zellij pipe --plugin "$ZELLIJ_SWITCH_PLUGIN" -- "--session $session_name --cwd $selected_dir"; then
    attach_or_create_session
  fi
else
  if session_exists; then
    if ! session_has_connected_clients; then
      zellij delete-session "$session_name" --force >/dev/null 2>&1 || true
      attach_or_create_session
    else
      zellij -s "$session_name" action new-tab --cwd "$selected_dir" >/dev/null 2>&1 || true
      if ! zellij attach "$session_name"; then
        attach_or_create_session
      fi
    fi
  else
    attach_or_create_session
  fi
fi

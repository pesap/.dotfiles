#!/usr/bin/env bash

if [[ -n "${ZELLIJ_SESSIONIZER_SEARCH_PATHS:-}" ]]; then
  read -r -a SEARCH_PATHS <<< "$ZELLIJ_SESSIONIZER_SEARCH_PATHS"
else
  SEARCH_PATHS=("$HOME/dev" "$HOME/tmp" "$HOME/sandbox" "$HOME/work")
fi

if [[ -n "${ZELLIJ_SESSIONIZER_SPECIFIC_PATHS:-}" ]]; then
  read -r -a SPECIFIC_PATHS <<< "$ZELLIJ_SESSIONIZER_SPECIFIC_PATHS"
else
  SPECIFIC_PATHS=("$HOME/.dotfiles")
fi

ZELLIJ_SESSIONIZER_MAX_DEPTH="${ZELLIJ_SESSIONIZER_MAX_DEPTH:-1}"
ZELLIJ_SWITCH_PLUGIN="${ZELLIJ_SESSIONIZER_SWITCH_PLUGIN:-"https://github.com/mostafaqanbaryan/zellij-switch/releases/download/0.2.1/zellij-switch.wasm"}"

session_name_for_dir() {
  local dir="$1"
  dir="${dir%/}"

  if [[ -d "$dir" ]]; then
    dir="$(cd "$dir" 2>/dev/null && pwd -P)"
  fi

  if [[ "$dir" == "$HOME" ]]; then
    dir="home"
  elif [[ "$dir" == "$HOME/"* ]]; then
    dir="${dir#$HOME/}"
  else
    dir="${dir#/}"
  fi

  dir="${dir//\//__}"
  dir="${dir// /_}"

  printf '%s\n' "$dir"
}

legacy_session_name_for_dir() {
  local dir="$1"
  dir="${dir%/}"
  printf '%s\n' "${dir##*/}"
}

SESSION_NAMES=()
SESSION_STATUSES=()

load_session_statuses() {
  SESSION_NAMES=()
  SESSION_STATUSES=()

  command -v zellij >/dev/null 2>&1 || return 0

  local line name status
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%[[:space:]]*}"

    if [[ "$line" == *"(current)"* ]]; then
      status="current"
    elif [[ "$line" == *"(EXITED"* ]]; then
      status="exited"
    else
      status="active"
    fi

    SESSION_NAMES+=("$name")
    SESSION_STATUSES+=("$status")
  done < <(zellij ls -n 2>/dev/null)
}

session_status_for_name() {
  local target="$1"
  local i

  for (( i=0; i<${#SESSION_NAMES[@]}; i++ )); do
    if [[ "${SESSION_NAMES[$i]}" == "$target" ]]; then
      printf '%s' "${SESSION_STATUSES[$i]}"
      return 0
    fi
  done

  return 1
}

print_display_entry() {
  local dir="$1"
  local display_name session_name legacy_session_name session_status

  [[ -d "$dir" ]] || return 0

  if [[ "$dir" == "$HOME"* ]]; then
    display_name="~${dir#$HOME}"
  else
    display_name="$dir"
  fi

  session_name=$(session_name_for_dir "$dir")
  session_status=$(session_status_for_name "$session_name" 2>/dev/null || true)

  if [[ -z "$session_status" ]]; then
    legacy_session_name=$(legacy_session_name_for_dir "$dir")
    session_status=$(session_status_for_name "$legacy_session_name" 2>/dev/null || true)
  fi

  if [[ -n "$session_status" ]]; then
    display_name="${display_name} (${session_status})"
  fi

  printf '%s\t%s\n' "$dir" "$display_name"
}

generate_display_list() {
  if ! command -v fd >/dev/null 2>&1; then
    echo "zellij-sessionizer: fd is required (same as fj)" >&2
    return 1
  fi

  local search_dirs=()
  local dir
  for dir in "${SEARCH_PATHS[@]}"; do
    [[ -d "$dir" ]] && search_dirs+=("$dir")
  done

  if [[ ${#search_dirs[@]} -eq 0 ]]; then
    echo "zellij-sessionizer: no search directories found" >&2
    return 1
  fi

  load_session_statuses

  while IFS= read -r dir; do
    [[ -n "$dir" ]] && print_display_entry "$dir"
  done < <(fd --type d \
    --exclude node_modules --exclude .bare \
    --max-depth "$ZELLIJ_SESSIONIZER_MAX_DEPTH" \
    . "${search_dirs[@]}" 2>/dev/null)

  for dir in "${SPECIFIC_PATHS[@]}"; do
    print_display_entry "$dir"
  done
}

delete_session_for_dir() {
  local target_dir="$1"
  local session_name legacy_session_name

  session_name=$(session_name_for_dir "$target_dir")
  legacy_session_name=$(legacy_session_name_for_dir "$target_dir")

  zellij delete-session "$session_name" --force 2>/dev/null || true

  # Backward-compat cleanup for sessions created with the old basename-only key.
  if [[ "$legacy_session_name" != "$session_name" ]]; then
    zellij delete-session "$legacy_session_name" --force 2>/dev/null || true
  fi
}

if [[ "$1" == "--generate-list" ]]; then
  generate_display_list
  exit $?
fi

if [[ "$1" == "--session-action" ]]; then
  action="$2"
  target_dir="$3"

  if [[ -z "$action" || -z "$target_dir" ]]; then
    exit 1
  fi

  case "$action" in
    delete|kill)
      delete_session_for_dir "$target_dir"
      ;;
    *)
      exit 1
      ;;
  esac

  exit 0
fi

selected_entry=$(generate_display_list | fzf --delimiter=$'\t' --with-nth=2.. \
  --prompt="Select project: " \
  --header="Enter: Select | Ctrl/Alt+D: Delete Session | Ctrl/Alt+K: Hard Kill Session" \
  --bind="ctrl-d:execute($0 --session-action delete {1})+reload($0 --generate-list)" \
  --bind="alt-d:execute($0 --session-action delete {1})+reload($0 --generate-list)" \
  --bind="ctrl-k:execute($0 --session-action kill {1})+reload($0 --generate-list)" \
  --bind="alt-k:execute($0 --session-action kill {1})+reload($0 --generate-list)")

if [[ -z "$selected_entry" ]]; then
  exit 0
fi
selected_dir="${selected_entry%%$'\t'*}"

session_name=$(session_name_for_dir "$selected_dir")

attach_or_create_session() {
  (
    cd "$selected_dir" || exit 1
    zellij attach "$session_name" --create
  )
}

session_has_connected_clients() {
  local client_count
  client_count=$(zellij -s "$session_name" action list-clients 2>/dev/null | awk 'NR > 1 {count++} END {print count + 0}')
  [[ "$client_count" -gt 0 ]]
}

if [[ -n "${ZELLIJ:-}" ]]; then
  if ! zellij pipe --plugin "$ZELLIJ_SWITCH_PLUGIN" -- "--session $session_name --cwd $selected_dir"; then
    attach_or_create_session
  fi
else
  if session_has_connected_clients; then
    zellij -s "$session_name" action new-tab --cwd "$selected_dir" >/dev/null 2>&1 || true
  fi

  if ! zellij attach "$session_name"; then
    attach_or_create_session
  fi
fi

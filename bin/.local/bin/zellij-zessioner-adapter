#!/usr/bin/env bash
# Zellij adapter for zessioner.
#
# The shared zessioner command owns the picker UI. This adapter owns Zellij
# session discovery and attach/switch/delete behavior.
set -uo pipefail

roots_value="${ZESSION_ROOTS:-$HOME/dev:$HOME/sandbox:$HOME/work:$HOME/.dotfiles}"
IFS=':' read -r -a roots <<< "$roots_value"

require_dependencies() {
  local dep
  for dep in zellij zoxide; do
    command -v "$dep" >/dev/null 2>&1 || {
      printf 'zellij-zessioner: %s is required\n' "$dep" >&2
      return 1
    }
  done
}

seed_zoxide() {
  local known root
  known=$(zoxide query -l 2>/dev/null) || return 0
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue
    grep -Fxq -- "$root" <<< "$known" || zoxide add -- "$root" 2>/dev/null
  done
}

session_name_for_path() {
  local path="${1%/}" name
  name="${path##*/}"
  [[ -n "$name" ]] || name="root"
  printf '%s\n' "$name" | tr -c '[:alnum:]._-' '_' | sed 's/_\{2,\}/_/g; s/^_//; s/_$//'
}

session_state_for_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  zellij list-sessions --no-formatting 2>/dev/null | awk -v name="$name" '
    $1 == name {
      if (index($0, "(EXITED")) print "exited"
      else if (index($0, "(current)")) print "current"
      else print "active"
      found = 1
      exit
    }
    END { if (!found) exit 1 }
  '
}

project_rows() {
  local path root name sequence=0
  while IFS= read -r path; do
    [[ -d "$path" ]] || continue
    for root in "${roots[@]}"; do
      if [[ -n "$root" && ( "$path" == "$root" || "$path" == "$root/"* ) ]]; then
        name=$(session_name_for_path "$path")
        printf 'project\t-\t%s\t%s\tproject\t2\t%09d\t%09d\n' \
          "$path" "$name" "$sequence" "$sequence"
        sequence=$((sequence + 1))
        break
      fi
    done
  done < <(zoxide query -l 2>/dev/null)
}

rows() {
  require_dependencies || return 1
  seed_zoxide

  {
    zellij list-sessions --no-formatting 2>/dev/null | awk '
      NF && !index($0, "(EXITED") {
        if (index($0, "(current)")) state = "current"
        else state = "active"
        print "zellij\t" $1 "\t" state
      }'
    zoxide query -l 2>/dev/null | while IFS= read -r path; do
      [[ -d "$path" ]] || continue
      for root in "${roots[@]}"; do
        if [[ -n "$root" && ( "$path" == "$root" || "$path" == "$root/"* ) ]]; then
          printf 'path\t%s\n' "$path"
          break
        fi
      done
    done
  } | awk -F '\t' '
    function session_name(path, name) {
      name = path
      sub(/\/+$/, "", name)
      sub(/^.*\//, "", name)
      gsub(/[^[:alnum:]._-]+/, "_", name)
      gsub(/_+/, "_", name)
      sub(/^_/, "", name)
      sub(/_$/, "", name)
      if (name == "") name = "root"
      return name
    }
    $1 == "zellij" {
      state[$2] = $3
      sessions[++session_count] = $2
      session_seen[$2] = 1
      next
    }
    $1 == "path" {
      path = $2
      name = session_name(path)
      if (session_seen[name]) {
        if (!(name in session_path)) session_path[name] = path
      } else if (!path_seen[path]++) {
        paths[++path_count] = path
        path_name[path_count] = name
      }
      next
    }
    END {
      for (i = 1; i <= session_count; i++) {
        name = sessions[i]
        path = (name in session_path) ? session_path[name] : ""
        rank = (state[name] == "current") ? 0 : 1
        printf "zellij\t%s\t%s\t%s\t%s\t%d\t%s\t%d\n", \
          name, path, name, state[name], rank, name, i
      }
      for (i = 1; i <= path_count; i++) {
        path = paths[i]
        printf "project\t-\t%s\t%s\tproject\t2\t%09d\t%09d\n", \
          path, path_name[i], i, i
      }
    }'
}

session_has_terminal_pane() {
  local name="$1"
  zellij --session "$name" action list-panes --all --json 2>/dev/null \
    | grep -q '"is_plugin": false'
}

session_exists() {
  [[ -n "$(session_state_for_name "${1:-}" 2>/dev/null || true)" ]]
}

delete_session() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  zellij delete-session --force -- "$name" 2>/dev/null
}

discard_exited_session() {
  local name="${1:-}" state
  state=$(session_state_for_name "$name" 2>/dev/null || true)
  [[ "$state" == "exited" ]] || return 0
  delete_session "$name"
}

ensure_background_session() {
  local name="$1" target_dir="${2:-}"
  if ! session_exists "$name"; then
    [[ -n "$target_dir" ]] || return 1
    (cd "$target_dir" && zellij attach "$name" --create-background) || return 1
    return 0
  fi
  if ! session_has_terminal_pane "$name"; then
    if [[ -n "$target_dir" ]]; then
      zellij --session "$name" run --cwd "$target_dir" -- "${SHELL:-zsh}" >/dev/null || return 1
    else
      zellij --session "$name" run -- "${SHELL:-zsh}" >/dev/null || return 1
    fi
  fi
}

attach_or_create() {
  local name="$1" target_dir="${2:-}"
  [[ -n "$target_dir" ]] && cd -- "$target_dir" || true
  zellij attach --create -- "$name"
}

select_row() {
  local kind="${1:-}" id="${2:-}" path="${3:-}" name="${4:-}"

  case "$kind" in
    zellij)
      name="$id"
      [[ -n "$name" ]] || return 1
      ;;
    project)
      [[ -n "$name" && -d "$path" ]] || return 1
      discard_exited_session "$name" || return 1
      ;;
    *)
      printf 'zellij-zessioner: unsupported row kind: %s\n' "$kind" >&2
      return 1
      ;;
  esac

  if [[ "$kind" == "zellij" ]]; then
    if [[ -n "${ZELLIJ:-}" ]]; then
      zellij action switch-session "$name" || {
        printf 'zellij-zessioner: failed to switch to session "%s"; refusing nested attach\n' "$name" >&2
        return 1
      }
    else
      zellij attach --create-background "$name" >/dev/null 2>&1 || true
      if ! session_has_terminal_pane "$name"; then
        zellij --session "$name" run -- "${SHELL:-zsh}" >/dev/null 2>&1 || true
      fi
      zellij attach "$name"
    fi
    return $?
  fi

  if [[ -n "${ZELLIJ:-}" ]]; then
    ensure_background_session "$name" "$path" || return 1
    zellij action switch-session "$name" --cwd "$path"
  else
    if session_exists "$name"; then
      zellij attach "$name" 2>/dev/null && return 0
    fi
    attach_or_create "$name" "$path"
  fi
}

case "${1:-}" in
  --rows) rows ;;
  --select) select_row "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  --close) delete_session "${2:-}" ;;
  --help|-h)
    printf '%s\n' 'Zellij adapter for zessioner.'
    ;;
  *) printf 'zellij-zessioner-adapter: unknown option\n' >&2; exit 2 ;;
esac

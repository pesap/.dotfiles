#!/usr/bin/env bash
#
# pr-digest - Fetch and display GitHub PR comments in a digestible format
#
# Usage: pr-digest <owner/repo> <pr-number>
#        pr-digest <pr-url>
#

set -euo pipefail

usage() {
    echo "Usage: pr-digest <owner/repo> <pr-number>"
    echo "       pr-digest <pr-url>"
    echo ""
    echo "Examples:"
    echo "  pr-digest anthropics/claude-code 123"
    echo "  pr-digest https://github.com/anthropics/claude-code/pull/123"
    exit 1
}

# Parse arguments
if [[ $# -eq 1 ]]; then
    # Assume it's a URL
    url="$1"
    if [[ "$url" =~ github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
        repo="${BASH_REMATCH[1]}"
        pr_number="${BASH_REMATCH[2]}"
    else
        echo "Error: Could not parse PR URL"
        usage
    fi
elif [[ $# -eq 2 ]]; then
    repo="$1"
    pr_number="$2"
else
    usage
fi

echo "=== PR #${pr_number} in ${repo} ==="
echo ""

# Fetch review comments (comments on specific lines of code)
echo "--- Review Comments (on code) ---"
echo ""

gh api "repos/${repo}/pulls/${pr_number}/comments" --paginate --jq '
    .[] |
    "Author: \(.user.login)\nDate: \(.created_at)\nFile: \(.path)\nLine: \(if .start_line then "\(.start_line)-\(.line)" else "\(.line // .original_line // "N/A")" end)\n\n\(.body)\n\n---\n"
' 2>/dev/null || echo "(No review comments)"

echo ""
echo "--- General Comments ---"
echo ""

# Fetch issue comments (general PR comments, not on specific lines)
gh api "repos/${repo}/issues/${pr_number}/comments" --paginate --jq '
    .[] |
    "Author: \(.user.login)\nDate: \(.created_at)\n\n\(.body)\n\n---\n"
' 2>/dev/null || echo "(No general comments)"

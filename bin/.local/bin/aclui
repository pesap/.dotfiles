#!/usr/bin/env python3
"""aclui - A friendly wrapper around setfacl/getfacl.

Features:
- ``aclui view <path>``: Show ACLs in a readable table.
- ``aclui set <path> <user:perms> [<user:perms> ...]``: Set ACL entries for users/groups.
- ``aclui set-default <dir> <user:perms> [<user:perms> ...]``: Set default ACLs on a directory so new files inherit them.
- ``aclui recursive-view <path>``: Recursively list ACLs for all files/dirs.

The tool delegates to the system ``getfacl`` and ``setfacl`` utilities but provides
nice formatting and reduces the need to remember flags.
"""

import argparse
import subprocess
import sys
from pathlib import Path
from typing import List

def run_cmd(cmd: List[str], dry_run: bool = False) -> subprocess.CompletedProcess:
    """Run a command, handling dry‑run mode.

    If *dry_run* is True, the command is printed to stderr and a dummy
    CompletedProcess with returncode 0 is returned without executing anything.
    This keeps the public API stable while allowing callers to preview actions.
    """
    if dry_run:
        print(f"[dry‑run] {' '.join(cmd)}", file=sys.stderr)
        # Mimic a successful run without side effects.
        return subprocess.CompletedProcess(args=cmd, returncode=0, stdout="", stderr="")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running: {' '.join(cmd)}", file=sys.stderr)
        print(result.stderr, file=sys.stderr)
        sys.exit(result.returncode)
    return result

def format_acl(raw: str, as_json: bool = False) -> str:
    """Strip comment header from *getfacl* output.

    If *as_json* is True, return a JSON string representing a list of ACL entries
    with keys ``type`` ("access" or "default"), ``entity`` (e.g. "u:alice"), and
    ``perms`` (e.g. "rwx"). Otherwise, return a human‑readable plain‑text table.
    """
    if as_json:
        import json
        entries = []
        for line in raw.splitlines():
            if line.startswith('#') or not line.strip():
                continue
            # Example line: "user:alice:rwx" or "default:user:alice:rwx"
            parts = line.split(":")
            if parts[0] == "default":
                _, kind, name, perms = parts
                entry_type = "default"
                entity = f"{kind}:{name}"
            else:
                kind, name, perms = parts
                entry_type = "access"
                entity = f"{kind}:{name}"
            entries.append({"type": entry_type, "entity": entity, "perms": perms})
        return json.dumps(entries, indent=2)
    # plain‑text mode – keep original behaviour
    lines = []
    for line in raw.splitlines():
        if line.startswith('#'):
            continue
        lines.append(line)
    return "\n".join(lines)

def view(path: Path, recursive: bool = False, json_out: bool = False) -> None:
    cmd = ["getfacl", "-p"]
    if recursive:
        cmd.append("-R")
    cmd.append(str(path))
    result = run_cmd(cmd)
    print(format_acl(result.stdout, as_json=json_out))

def parse_entries(entries: List[str]) -> List[str]:
    """Validate *user:perms* entries and convert them to ``setfacl`` syntax.

    Permissions must be a non‑empty combination of ``r``, ``w``, ``x`` or ``-``.
    The function returns a list like ``["u:alice:rwx", ...]`` suitable for the
    ``-m`` flag.
    """
    parsed = []
    for entry in entries:
        if ":" not in entry:
            print(f"Invalid entry '{entry}'. Expected format user:perms", file=sys.stderr)
            sys.exit(2)
        user, perms = entry.split(":", 1)
        if not perms:
            print(f"Permissions missing for '{user}'.", file=sys.stderr)
            sys.exit(2)
        # Validate permission characters
        if any(c not in "rwx-" for c in perms):
            print(f"Invalid permission characters in '{perms}'. Use only r, w, x, -.", file=sys.stderr)
            sys.exit(2)
        parsed.append(f"u:{user}:{perms}")
    return parsed

def set_acl(path: Path, entries: List[str], dry_run: bool = False) -> None:
    acl_args = parse_entries(entries)
    cmd = ["setfacl", "-m"] + acl_args + [str(path)]
    run_cmd(cmd, dry_run=dry_run)
    if not dry_run:
        print(f"ACL set on {path}")
    else:
        print(f"[dry‑run] ACL would be set on {path}")

def set_default(dir_path: Path, entries: List[str], dry_run: bool = False) -> None:
    if not dir_path.is_dir():
        print(f"{dir_path} is not a directory", file=sys.stderr)
        sys.exit(3)
    acl_args = parse_entries(entries)
    # ``-d`` sets default ACLs; ``-R`` applies to existing children as well.
    cmd = ["setfacl", "-R", "-d", "-m"] + acl_args + [str(dir_path)]
    run_cmd(cmd, dry_run=dry_run)
    if not dry_run:
        print(f"Default ACL set on {dir_path} (and existing children)")
    else:
        print(f"[dry‑run] Default ACL would be set on {dir_path} (and existing children)")

def main() -> None:
    # Global parser – includes common flags that affect all sub‑commands.
    parser = argparse.ArgumentParser(
        prog="aclui",
        description="Friendly ACL manager – a well‑designed CLI wrapper around setfacl/getfacl",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument("--json", action="store_true", help="Emit machine‑readable JSON for commands that support it (currently `view`).")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done without changing any ACLs.")
    parser.add_argument("--verbose", "-v", action="store_true", help="Print detailed debugging information to stderr.")

    subparsers = parser.add_subparsers(dest="command", required=True)

    # ----- view -----------------------------------------------------------
    view_parser = subparsers.add_parser(
        "view",
        help="Show ACLs for a file or directory",
        description="Display ACL entries. Use --json for structured output.",
    )
    view_parser.add_argument("path", type=Path, help="File or directory to inspect")
    view_parser.add_argument("-R", "--recursive", action="store_true", help="Recursively list ACLs for all children.")

    # ----- set ------------------------------------------------------------
    set_parser = subparsers.add_parser(
        "set",
        help="Add or modify ACL entries on a path",
        description="Set ACLs for users or groups. Entries use the form USER:PERMS (e.g. alice:rwx).",
    )
    set_parser.add_argument("path", type=Path, help="Target file or directory")
    set_parser.add_argument("entries", nargs="+", help="One or more USER:PERMS specifications.")

    # ----- set-default ----------------------------------------------------
    def_parser = subparsers.add_parser(
        "set-default",
        help="Set default ACLs on a directory for inheritance",
        description="New files created under the directory will inherit these ACLs.",
    )
    def_parser.add_argument("dir", type=Path, help="Target directory")
    def_parser.add_argument("entries", nargs="+", help="USER:PERMS specifications applied as default ACLs.")

    args = parser.parse_args()

    # Verbose debugging helper
    def vprint(*msg):
        if args.verbose:
            print(*msg, file=sys.stderr)

    if args.command == "view":
        vprint("Executing view", args.path, "recursive=" + str(args.recursive))
        view(args.path, recursive=args.recursive, json_out=args.json)
    elif args.command == "set":
        vprint("Executing set on", args.path, "entries=", args.entries, "dry_run=" + str(args.dry_run))
        set_acl(args.path, args.entries, dry_run=args.dry_run)
    elif args.command == "set-default":
        vprint("Executing set-default on", args.dir, "entries=", args.entries, "dry_run=" + str(args.dry_run))
        set_default(args.dir, args.entries, dry_run=args.dry_run)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()

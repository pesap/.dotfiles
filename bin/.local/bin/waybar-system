#!/bin/sh
set -eu

busy=''
for path in /sys/class/drm/card*/device/gpu_busy_percent; do
	[ -r "$path" ] || continue
	IFS= read -r busy <"$path" || true
	break
done

for path in /sys/class/hwmon/hwmon*/name; do
	[ -r "$path" ] || continue
	IFS= read -r hwmon_name <"$path" || true
	[ "${hwmon_name:-}" = amdgpu ] || continue
	hwmon_dir="${path%/name}"
	for temp_path in "$hwmon_dir"/temp*_input; do
		[ -r "$temp_path" ] || continue
		IFS= read -r temp_value <"$temp_path" || true
		[ "${temp_value:-0}" -gt 0 ] 2>/dev/null || continue
		temp_c=$((temp_value / 1000))
		break 2
	done
done

gpu_short="󰢮 ${busy:-?}%"
gpu="$gpu_short"
[ -n "${temp_c:-}" ] && gpu="$gpu ${temp_c}°C"

usage="$(df -P "$HOME" 2>/dev/null | awk 'NR==2 {print $5}')"
disk="󰋊 ${usage:-?}"

weather='unavailable'
weather_cache="${XDG_CACHE_HOME:-$HOME/.cache}/waybar/weather"
if [ -s "$weather_cache" ]; then
	weather="$(jq -r '.text // "unavailable"' "$weather_cache" 2>/dev/null || printf unavailable)"
	weather="${weather#󰖐 }"
fi

text="$gpu_short  $disk"
tooltip="GPU: $gpu\nDisk: $disk\nWeather: $weather"
jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text:$text,tooltip:$tooltip}'

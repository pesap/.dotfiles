#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: dotfiles COMMAND

Commands:
  validate    Run read-only repository and isolated regression checks
  outdated    Report outdated mise-managed tools without installing them
  help        Show this help
EOF
}

resolve_repo_root() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir=''
    local link_target=''

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd "$(dirname "$source_path")" && pwd -P)"
        link_target="$(readlink "$source_path")"
        if [[ "$link_target" == /* ]]; then
            source_path="$link_target"
        else
            source_path="$source_dir/$link_target"
        fi
    done

    cd "$(dirname "$source_path")/../../.." && pwd -P
}

command_name="${1:-help}"
case "$command_name" in
validate)
    shift
    exec "$(resolve_repo_root)/scripts/validate.sh" "$@"
    ;;
outdated)
    shift
    command -v mise >/dev/null 2>&1 || {
        printf 'dotfiles: mise is required for outdated checks\n' >&2
        exit 1
    }
    exec mise outdated "$@"
    ;;
help | -h | --help)
    usage
    ;;
*)
    printf 'dotfiles: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac

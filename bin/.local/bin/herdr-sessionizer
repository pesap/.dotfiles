#!/usr/bin/env bash
set -euo pipefail

IFS=: read -r -a roots <<< "${HERDR_PROJECT_ROOTS:-$HOME/dev:$HOME/work:$HOME/projects:$HOME/personal:$HOME/sandbox}"
state_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/herdr-sessionizer"
request_file="$state_dir/request"
active_file="$state_dir/active"
mkdir -p "$state_dir"
chmod 700 "$state_dir"

pick_project() {
    fd --type d --min-depth 1 --max-depth 1 --exclude .bare . "${roots[@]}" 2>/dev/null |
        fzf --prompt='herdr › '
}

if [[ "${1:-}" == --select ]]; then
    read -r sessionizer_pid <"$active_file" 2>/dev/null || {
        printf 'Launch Herdr with herdr-sessionizer first.\n' >&2
        sleep 2
        exit 1
    }
    kill -0 "$sessionizer_pid" 2>/dev/null || exit 1
    selected=$(pick_project) || exit 0
    [[ -n "$selected" ]] && printf '%s\n' "$selected" >"$request_file"
    exit 0
fi

[[ "${HERDR_ENV:-}" != 1 ]] || {
    printf 'Use Ctrl+\\ to switch Herdr sessions without nesting.\n' >&2
    exit 1
}

printf '%s\n' "$$" >"$active_file"
rm -f -- "$request_file"
trap 'rm -f -- "$active_file" "$request_file"' EXIT
selected="${1:-}"

while true; do
    [[ -n "$selected" ]] || selected=$(pick_project) || exit 0
    [[ -d "$selected" ]] || { printf 'Not a project directory: %s\n' "$selected" >&2; exit 1; }

    session_name=$(basename "$selected" | tr . _)
    rm -f -- "$request_file"
    previous_dir=$PWD
    cd -- "$selected"
    herdr --session "$session_name" &
    client_pid=$!
    cd -- "$previous_dir"

    while kill -0 "$client_pid" 2>/dev/null && [[ ! -s "$request_file" ]]; do
        sleep 0.05
    done
    [[ ! -s "$request_file" ]] || kill -INT "$client_pid" 2>/dev/null || true
    status=0
    wait "$client_pid" || status=$?

    [[ -s "$request_file" ]] || exit "$status"
    read -r selected <"$request_file"
done

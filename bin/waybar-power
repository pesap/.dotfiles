#!/bin/sh
set -eu

case "${1:-status}" in
	cycle)
		current="$(powerprofilesctl get 2>/dev/null || printf balanced)"
		next="balanced"
		case "$current" in
			performance) next=balanced ;;
			balanced) next=power-saver ;;
			power-saver) next=performance ;;
		esac
		powerprofilesctl set "$next"
		;;
esac

profile="$(powerprofilesctl get 2>/dev/null || printf unknown)"
case "$profile" in
	performance) label='PERF' ;;
	power-saver) label='SAVE' ;;
	balanced) label='BAL' ;;
	*) label='PWR' ;;
esac
jq -cn --arg text "$label" --arg profile "$profile" \
	--arg tooltip "Power profile: $profile" \
	'{text:$text,class:$profile,tooltip:$tooltip}'

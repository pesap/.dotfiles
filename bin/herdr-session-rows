#!/usr/bin/env bash
set -euo pipefail

script_path=${BASH_SOURCE[0]}
while [[ -L "$script_path" ]]; do
    link_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
    link_target=$(readlink "$script_path")
    if [[ "$link_target" == /* ]]; then
        script_path=$link_target
    else
        script_path=$link_dir/$link_target
    fi
done
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
# shellcheck source=bin/project-paths.sh
source "$script_dir/project-paths.sh"

exclude_default=false
include_projects=false
for argument in "$@"; do
    case "$argument" in
    --exclude-default) exclude_default=true ;;
    --include-projects) include_projects=true ;;
    *)
        printf 'Usage: herdr-session-rows [--exclude-default] [--include-projects]\n' >&2
        exit 2
        ;;
    esac
done

session_refs=$(jq -ces --argjson exclude_default "$exclude_default" '
    if length != 1 or (.[0].sessions | type) != "array" then
        error("invalid session list")
    else .[0].sessions end
    | map(select(type == "object"))
    | map(select((.name | type) == "string" and (.session_dir | type) == "string"))
    | map(select(.name != "" and ((.name | test("[\\r\\n]")) | not)))
    | if $exclude_default then map(select(.name != "default")) else . end
') || {
    printf 'herdr-session-rows: invalid Herdr session list\n' >&2
    exit 1
}

use_color=false
if [[ -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    use_color=true
fi

# Batch metadata parsing as well as row formatting. JSON process counts do not
# grow with the number of projects or saved sessions.
read_session_paths() {
    local name running session_dir metadata
    while IFS= read -r -d '' name &&
        IFS= read -r -d '' running &&
        IFS= read -r -d '' session_dir; do
        [[ -r "$session_dir/session.json" ]] || continue
        metadata=$(<"$session_dir/session.json")
        printf '%s\0%s\0%s\0' "$name" "$running" "$metadata"
    done < <(jq -j '.[] | .name, "\u0000",
        (if (.running | type) == "boolean" then (.running | tostring) else "" end),
        "\u0000", .session_dir, "\u0000"' <<<"$session_refs") |
        jq -Rjs '
            split("\u0000") | .[:-1]
            | range(0; length; 3) as $i | .[$i:$i+3]
            | .[0] as $name | .[1] as $running
            | (try (.[2] | fromjson) catch null) | select(type == "object")
            | select((.active | type) == "number" and (.workspaces | type) == "array")
            | select(.active >= 0 and .active == (.active | floor) and .active < (.workspaces | length))
            | .workspaces[.active] | select(type == "object")
            | .identity_cwd | select(type == "string") | select(startswith("/"))
            | $name, "\u0000", $running, "\u0000", ., "\u0000"
        '
}

# Keep the session's active path for preview and base path for display.
{
    while IFS= read -r -d '' name &&
        IFS= read -r -d '' running &&
        IFS= read -r -d '' session_path; do
        if [[ -d "$session_path" ]]; then
            project_resolve_path "$session_path" || continue
        else
            project_path=$session_path
        fi
        printf 'session\0%s\0%s\0%s\0%s\0' "$name" "$running" "$session_path" "$project_path"
    done < <(read_session_paths)

    if [[ "$include_projects" == true ]]; then
        project_paths=$(project_discover_paths "${PROJECT_PATHS_FILE:-$script_dir/../project_paths}") || exit 1
        while IFS= read -r path; do
            [[ -n "$path" ]] || continue
            printf 'project\0%s\0\0%s\0%s\0' "$path" "$path" "$path"
        done <<<"$project_paths"
    fi
} | jq -Rrs --argjson use_color "$use_color" --argjson include_projects "$include_projects" '
    split("\u0000") | .[:-1]
    | [range(0; length; 5) as $i | .[$i:$i+5]
        | {kind: .[0], id: .[1], running: .[2], path: .[3], project: .[4]}]
    | (reduce (.[] | select(.kind == "project")) as $p ({}; .[$p.project] = length)) as $allowed
    | map(select(($include_projects | not) or $allowed[.project] != null))
    | (reduce (.[] | select(.kind == "session")) as $s ({}; .[$s.project] = true)) as $saved
    | map(select(.kind == "session" or ($saved[.project] | not)))
    | sort_by((if $include_projects then $allowed[.project] else .project end), .kind, .id)[]
    | (.project | gsub("[\t\r\n]"; " ")) as $display
    | (if $use_color and .kind == "session" and .running == "true" then
          "\u001b[32m" + $display + "\u001b[0m"
       elif $use_color and .kind == "session" and .running == "false" then
          "\u001b[90m" + $display + "\u001b[0m"
       else $display end) as $display
    | [(.id | @base64), $display, (.path | tojson), .kind] | join("\t")
'

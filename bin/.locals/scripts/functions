# Zellij functions
function zr () { zellij run --name "$*" -- zsh -ic "$*";}
function zrf () { zellij run --name "$*" --floating -- zsh -ic "$*";}
function zri () { zellij run --name "$*" --in-place -- zsh -ic "$*";}
function ze () { zellij edit "$*";}
function zef () { zellij edit --floating "$*";}
function zei () { zellij edit --in-place "$*";}
function zpipe () { 
  if [ -z "$1" ]; then
    zellij pipe;
  else 
    zellij pipe -p $1;
  fi
}
function fp() {
  local selected
  selected=$(zoxide query --list |
    fzf \
      --layout=reverse \
      --border \
      --header="Select a Repo" \
      --header-first \
      --margin=10,30 \
      --padding=1 \
      --ansi \
      --preview 'exa --color=always --long --no-filesize --no-time --no-user --no-permissions {}') 
  if [[ -z "$selected" ]]; then
    return 1
  fi

  cd "$selected" || return 1

  if git rev-parse --is-inside-work-tree &>/dev/null; then
    if [[ $(git worktree list | wc -l) -gt 1 ]]; then
      selected=$(git worktree list | awk '!/bare/' | fzf --border --header="Git Workree" --header-first --border-label-pos=-1 --layout=reverse --border --margin=8,20 --padding=1 --ansi | awk '{print $1}') || return 1
      cd "$selected" || return 1
    fi
    echo -ne '\n'
  fi
}
bindkey '^F' fp
zle -N fp
swt() {
  local dir
  dir=$(git worktree list | fzf | awk '{print $1}') || return 1
  cd "$dir" || return 1
  zle reset-prompt
}
bindkey '^W' swt
zle -N swt
dwt() {
  local worktree_to_delete
  worktree_to_delete=$(git worktree list | fzf| sed 's/^[ *]*//')
  echo $worktree_to_delete
}

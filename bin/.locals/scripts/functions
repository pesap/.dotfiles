# Zellij functions
function zr () { zellij run --name "$*" -- zsh -ic "$*";}
function zrf () { zellij run --name "$*" --floating -- zsh -ic "$*";}
function zri () { zellij run --name "$*" --in-place -- zsh -ic "$*";}
function ze () { zellij edit "$*";}
function zef () { zellij edit --floating "$*";}
function zei () { zellij edit --in-place "$*";}
function zpipe () { 
  if [ -z "$1" ]; then
    zellij pipe;
  else 
    zellij pipe -p $1;
  fi
}

function fp (){
  local selected
  selected=$(zoxide query --list |
    fzf  \
    --ansi \
    --preview 'exa --color=always --long --no-filesize --no-time --no-user --no-permissions {}')
  if [[ -n "$selected" ]]; then
    cd $selected && nvim .
  fi
}

#!/usr/bin/env bash
set -euo pipefail

roots_value="${PROJECT_ROOTS-${HERDR_PROJECT_ROOTS:-$HOME/dev:$HOME/work:$HOME/sandbox:$HOME:$HOME/personal}}"
paths_value="${PROJECT_PATHS-$HOME/.dotfiles}"

IFS=: read -r -a roots <<< "$roots_value"
IFS=: read -r -a paths <<< "$paths_value"

command -v fd >/dev/null 2>&1 || {
    printf 'project-dirs: fd is required\n' >&2
    exit 1
}

{
    for path in "${paths[@]}"; do
        [[ -d "$path" ]] && printf '%s\n' "$path"
    done

    search_roots=()
    for root in "${roots[@]}"; do
        if [[ -d "$root" ]]; then
            search_roots+=("$root")
        fi
    done
    if ((${#search_roots[@]} > 0)); then
        fd --type d --min-depth 1 --max-depth 1 --exclude .bare . \
            "${search_roots[@]}" 2>/dev/null
    fi
} | awk -v excluded="${HOME%/}/worktrees" \
    '$0 != excluded && $0 != excluded "/" && !seen[$0]++'

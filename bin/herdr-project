#!/usr/bin/env bash
set -euo pipefail

script_path=${BASH_SOURCE[0]}
while [[ -L "$script_path" ]]; do
    link_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
    link_target=$(readlink "$script_path")
    if [[ "$link_target" == /* ]]; then
        script_path=$link_target
    else
        script_path=$link_dir/$link_target
    fi
done
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)

case "${1:-}" in
    --select)
        shift
        exec "$script_dir/herdr-session-select" "$@"
        ;;
    --session-kill)
        shift
        exec "$script_dir/herdr-session-kill" "$@"
        ;;
esac

picker="${HERDR_PROJECT_PICKER:-$script_dir/project-picker}"
namer="${HERDR_PROJECT_NAME:-$script_dir/project-name}"
session_killer="$script_dir/herdr-session-kill"

state_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/herdr-project"
request_file="$state_dir/request"
kill_request_file="$state_dir/kill-request"
active_file="$state_dir/active"
client_file="$state_dir/client"
session_file="$state_dir/session"
mkdir -p "$state_dir"
chmod 700 "$state_dir"

pick_project() {
    PROJECT_PICKER_PROMPT='herdr › ' "$picker"
}

[[ "${HERDR_ENV:-}" != 1 ]] || {
    printf 'Use Ctrl+\\ to switch Herdr sessions without nesting.\n' >&2
    exit 1
}

printf '%s\n' "$$" >"$active_file"
rm -f -- "$request_file" "$kill_request_file"
trap 'rm -f -- "$active_file" "$request_file" "$kill_request_file" "$client_file" "$session_file"' EXIT
selected="${1:-}"
session_override=''

while true; do
    [[ -n "$selected" ]] || selected=$(pick_project) || exit 0
    [[ -d "$selected" ]] || {
        printf 'Not a project directory: %s\n' "$selected" >&2
        exit 1
    }

    if [[ -n "$session_override" ]]; then
        session_name=$session_override
        session_override=''
    else
        session_name=$("$namer" "$selected")
    fi
    printf '%s\n' "$session_name" >"$session_file"
    rm -f -- "$request_file" "$kill_request_file" "$client_file"

    watch_request() {
        local client_pid=''
        while [[ ! -s "$client_file" ]]; do
            sleep 0.05
        done
        read -r client_pid <"$client_file"
        while kill -0 "$client_pid" 2>/dev/null; do
            if [[ -s "$request_file" || -s "$kill_request_file" ]]; then
                kill -INT "$client_pid" 2>/dev/null || true
                return
            fi
            sleep 0.05
        done
    }

    watch_request &
    watcher_pid=$!
    status=0
    (
        cd -- "$selected"
        exec bash -c 'printf "%s\n" "$$" >"$1"; shift; exec herdr "$@"' \
            herdr-project-client "$client_file" --session "$session_name"
    ) || status=$?
    kill "$watcher_pid" 2>/dev/null || true
    wait "$watcher_pid" 2>/dev/null || true
    rm -f -- "$client_file"

    if [[ -s "$kill_request_file" ]]; then
        kill_request=$(<"$kill_request_file")
        rm -f -- "$kill_request_file"
        session_to_kill=$(jq -er '.name | strings' <<<"$kill_request") || {
            printf 'herdr-project: invalid session stop request\n' >&2
            exit 1
        }
        [[ "$session_to_kill" == "$session_name" ]] || {
            printf 'herdr-project: refusing to stop a session other than the current project session\n' >&2
            exit 1
        }
        "$session_killer" --yes "$session_to_kill" || exit $?
        exit 0
    fi

    if [[ -s "$request_file" ]]; then
        attach_request=$(<"$request_file")
        rm -f -- "$request_file"
        session_override=$(jq -er '.name | strings' <<<"$attach_request") || {
            printf 'herdr-project: invalid session attach request\n' >&2
            exit 1
        }
        [[ -n "$session_override" ]] || {
            printf 'herdr-project: empty session attach request\n' >&2
            exit 1
        }
        [[ "$session_override" != "$session_name" ]] || exit "$status"
        continue
    fi

    exit "$status"
done

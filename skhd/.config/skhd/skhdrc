# skhd configuration
# Hotkey daemon for macOS

# App switching (focus or open if not running)
# Space 1: Terminal & Browser
alt - 1 : yabai -m space --focus 1; ~/.local/bin/macos-switchapp Alacritty
alt - 2 : yabai -m space --focus 1; ~/.local/bin/macos-switchapp Safari

# Space 2: Finder
alt - 0 : yabai -m space --focus 2; ~/.local/bin/macos-switchapp Finder

# Space 3: Microsoft Teams
alt - 3 : yabai -m space --focus 3; ~/.local/bin/macos-switchapp "Microsoft Teams"

# Space 4: Outlook
alt - 4 : yabai -m space --focus 4; ~/.local/bin/macos-switchapp "Microsoft Outlook"

# New private Safari window
cmd - return : ~/.local/bin/macos-incognito

# Yabai window management
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# Cycle through layouts: bsp -> stack -> float -> bsp
alt - space : current=$(yabai -m query --spaces --space | jq -r '.type'); \
              case "$current" in \
                bsp) yabai -m space --layout stack ;; \
                stack) yabai -m space --layout float ;; \
                float) yabai -m space --layout bsp ;; \
              esac

# skhd configuration
# Hotkey daemon for macOS

# App switching (focus or open if not running)
# Space 1: Terminal & Browser
alt - 1 : yabai -m space --focus 1; ~/.local/bin/switchapp.sh Alacritty
alt - 2 : yabai -m space --focus 1; ~/.local/bin/switchapp.sh Safari

# Space 2: Finder
alt - 0 : yabai -m space --focus 2; ~/.local/bin/switchapp.sh Finder

# Space 3: Microsoft Teams
alt - 3 : yabai -m space --focus 3; ~/.local/bin/switchapp.sh "Microsoft Teams"

# Space 4: Outlook
alt - 4 : yabai -m space --focus 4; ~/.local/bin/switchapp.sh "Microsoft Outlook"

# New private Safari window
cmd - return : ~/.local/bin/incognito.sh

# Yabai window management
alt + shift - f : yabai -m window --toggle zoom-fullscreen

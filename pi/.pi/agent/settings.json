{
  "lastChangelogVersion": "0.82.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "packages": [
    "https://github.com/crustyhacker/pi-thinking-steps",
    "npm:pi-web-access"
  ],
  "subagents": {
    "agentOverrides": {
      "planner": {"model": "gpt-5.4"},
      "scout": {"model": "ollama/local-scout:4b", "thinking": "low"},
      "worker": {"model": "gpt-5.4", "thinking": "medium"},
      "reviewer": {"model": "gpt-5.4", "thinking": "medium"}
    }
  },
  "theme": "dark",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "steeringMode": "one-at-a-time",
  "transport": "auto",
  "showCacheMissNotices": true,
  "collapseChangelog": true
}

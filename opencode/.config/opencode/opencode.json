{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-opus-4-6",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./agent/build.md}",
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "reviewer": {
      "description": "Review code changes for correctness, quality, security, performance, and architecture",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt": "{file:./agent/reviewer.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "ask",
        "edit": "deny",
        "write": "deny"
      }
    },
    "simplify": {
      "description": "Simplifies and refines code for clarity, consistency, and maintainability",
      "mode": "primary",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:./agent/simplify.md}",
      "temperature": 0.1,
      "permission": {
        "write": "allow",
        "edit": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny"
      }
    }
  }
}

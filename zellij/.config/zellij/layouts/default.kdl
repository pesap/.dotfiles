// Vertical tab bar on the LEFT side
// Source: ~/dev/zellij-vertical-tabs/examples/vertical-tabs-left.kdl
keybinds {
    shared {
        // Toggle selectability (for resizing the pane)
        bind "Alt s" {
            MessagePlugin "file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm" {
                name "toggle_selectable"
            }
        }
    }
}
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-locked-indicator.wasm"
        }
    }
    pane split_direction="vertical" {
        pane size=18 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm" {
                format "#[fg=muted]{index} #[fg=none]{name}"
                format_active "#[fg=accent]▶ {index} {name} #[fg=success]{indicators}"
                indicator_active "●"
                indicator_fullscreen "□"
                indicator_sync "⇄"
                max_name_length 14
            }
        }
        pane borderless=true
    }
}

layout {
    pane_template name="main" {
        borderless true
    }
    tab name="work" focus=true {
        main
    }

    swap_floating_layout name="staggered" {
        floating_panes max_panes=1 {
            pane { x "10%"; y "10%"; width "80%"; height "80%"; }
        }
        floating_panes max_panes=2 {
            pane { x "5%"; y "5%"; width "45%"; height "45%"; }
            pane { x "50%"; y "50%"; width "45%"; height "45%"; }
        }
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=1 {
            pane { x "5%"; y "5%"; width "90%"; height "90%"; }
        }
        floating_panes max_panes=2 {
            pane { x "5%"; y "5%"; width "90%"; height "45%"; }
            pane { x "5%"; y "52%"; width "90%"; height "45%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { x "25%"; y "25%"; width "50%"; height "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "5%"; y "25%"; width "45%"; height "50%"; }
            pane { x "50%"; y "25%"; width "45%"; height "50%"; }
        }
    }
}

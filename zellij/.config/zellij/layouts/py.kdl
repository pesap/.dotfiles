layout {
    tab name="python" focus=true {
        pane borderless=true command="zsh" {
            args "-c" "source .venv/bin/activate 2>/dev/null; nvim ."
        }
        floating_panes {
            pane name="test" command="zsh" start_suspended=true {
                args "-c" "uv run pytest tests/ --tb=short"
            }
            pane name="shell" command="zsh" start_suspended=true {
                args "-c" "source .venv/bin/activate; exec zsh"
            }
            pane name="deps" edit="pyproject.toml"
        }
    }
}
